{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["dimensions", "overall_level", "overall_reason", "priority_title", "priority_detail", "limitations"],
  "properties": {
    "dimensions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "level", "conclusion", "quote", "reason"],
        "properties": {
          "name": {"type": "string"},
          "level": {"type": "integer", "minimum": 1, "maximum": 6},
          "conclusion": {"type": "string"},
          "quote": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "overall_level": {"type": "integer", "minimum": 0, "maximum": 6},
    "overall_reason": {"type": "string"},
    "priority_title": {"type": "string"},
    "priority_detail": {"type": "string"},
    "limitations": {"type": "string"}
  }
}
